---
layout: layouts/base.njk
---
<article>
  <h1>{{ title }}</h1>
  {% if subtitle %}<p class="subtitle">{{ subtitle }}</p>{% endif %}
  <hr>
  {{ content | safe }}
  {% if cluster %}
  <section>
    <h2>{% if lang == 'cy' %}Tudalennau yn y Clwstwr Hwn{% else %}Pages in This Cluster{% endif %}</h2>
    <ul class="cluster-list">
      {% for page in collections.all %}
        {% if page.data.cluster == cluster and page.data.lang == lang and page.data.type == "entity-page" %}
        <li><a href="{{ page.url }}">{{ page.data.title }}</a></li>
        {% endif %}
      {% endfor %}
    </ul>
  </section>
  {% endif %}
</article>
